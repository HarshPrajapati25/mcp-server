{
  "name": "shoppingate-mcp-server",
  "version": "1.0.0",
  "description": "Shoppinggate AI Platform — MCP Server (Merchant & Customer Tools in TypeScript)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "node dist/index.js",
    "start:stdio": "cross-env TRANSPORT_MODE=stdio node dist/index.js",
    "start:sse": "cross-env TRANSPORT_MODE=sse node dist/index.js",
    "dev": "ts-node src/index.ts",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "shoppingate",
    "claude",
    "chatgpt",
    "ai-connector"
  ],
  "author": "Shoppingate Team",
  "license": "ISC",
  "dependencies": {
    "@langchain/core": "^1.2.5",
    "@langchain/langgraph": "^1.4.9",
    "@langchain/openai": "^1.5.6",
    "@modelcontextprotocol/sdk": "^1.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/uuid": "^10.0.0",
    "axios": "^1.10.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "uuid": "^14.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.19",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
