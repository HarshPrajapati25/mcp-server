{
  "openapi": "3.0.1",
  "info": {
    "title": "Shoppingate Enterprise Super-App AI Gateway",
    "description": "Dual-Scope MCP & OpenAPI Actions for ChatGPT & Claude — complete access to ECOM, FLIGHT, HOTEL, ORDERS, and RECOMMENDATION-ENGINE backends.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3005",
      "description": "Local AI Gateway Server"
    },
    {
      "url": "https://microservices.shoppinggate.app/mcp",
      "description": "Production Dev Gateway"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Merchant JWT Token obtained from https://microservices.shoppinggate.app/sg-merchant/auth/login"
      }
    }
  },
  "paths": {
    "/api/tools/search_products": {
      "post": {
        "summary": "Search catalog products",
        "operationId": "searchProducts",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": { "type": "string" },
                  "page": { "type": "integer", "default": 1 },
                  "limit": { "type": "integer", "default": 10 },
                  "minPrice": { "type": "number" },
                  "maxPrice": { "type": "number" },
                  "lang": { "type": "string", "default": "en" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Search results" } }
      }
    },
    "/api/tools/customer_search_products": {
      "post": {
        "summary": "Customer product discovery",
        "operationId": "customerSearchProducts",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": { "type": "string" },
                  "maxPrice": { "type": "number" },
                  "category": { "type": "string" },
                  "lang": { "type": "string", "default": "en" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Filtered products" } }
      }
    },
    "/api/tools/get_product_details": {
      "post": {
        "summary": "Get product details by ID or title",
        "operationId": "getProductDetails",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "productId": { "type": "string", "description": "Product ID or Title" },
                  "lang": { "type": "string", "default": "en" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Product details" } }
      }
    },
    "/api/tools/check_shipping_eta": {
      "post": {
        "summary": "Check shipping delivery timeline and fee",
        "operationId": "checkShippingEta",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "productIdOrName": { "type": "string" },
                  "destinationCity": { "type": "string", "default": "Riyadh" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Delivery ETA and shipping cost" } }
      }
    },
    "/api/tools/get_product_reviews": {
      "post": {
        "summary": "Get star ratings and customer reviews",
        "operationId": "getProductReviews",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "productIdOrName": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Product reviews" } }
      }
    },
    "/api/tools/track_customer_order": {
      "post": {
        "summary": "Track customer orders by Order ID or User ID",
        "description": "Track delivery status, shipment updates, or look up customer orders by Customer User ID (e.g. 8362, 8543) or Order ID (e.g. ORD-2026-102, 102).",
        "operationId": "trackCustomerOrder",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "orderId": { "type": "string", "description": "Order ID (e.g. ORD-2026-102) or Customer User ID (e.g. 8362, 8543)" },
                  "userId": { "type": "string", "description": "Customer User ID (e.g. 8362, 8543)" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Tracking status" } }
      }
    },
    "/api/tools/list_product_categories": {
      "post": {
        "summary": "List product categories",
        "operationId": "listProductCategories",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "lang": { "type": "string", "default": "en" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "Store categories" } }
      }
    },
    "/api/tools/list_brand_storefronts": {
      "post": {
        "summary": "List official brand storefronts",
        "operationId": "listBrandStorefronts",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "lang": { "type": "string", "default": "en" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "Brand list" } }
      }
    },
    "/api/tools/get_return_policy_and_reasons": {
      "post": {
        "summary": "View return policy and valid reasons",
        "operationId": "getReturnPolicyAndReasons",
        "responses": { "200": { "description": "Return policy details" } }
      }
    },
    "/api/tools/submit_return_request": {
      "post": {
        "summary": "Submit order return or refund request",
        "operationId": "submitReturnRequest",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "orderId": { "type": "string" },
                  "productId": { "type": "string" },
                  "reasonId": { "type": "integer", "default": 1 },
                  "comments": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Return request confirmation" } }
      }
    },
    "/api/tools/manage_cart": {
      "post": {
        "summary": "View or update customer shopping cart",
        "operationId": "manageCart",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "action": { "type": "string", "enum": ["view", "add", "update", "remove", "clear"], "default": "view" },
                  "productId": { "type": "string" },
                  "cartId": { "type": "integer" },
                  "quantity": { "type": "integer", "default": 1 }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Cart contents" } }
      }
    },
    "/api/tools/manage_wishlist": {
      "post": {
        "summary": "View or update customer wishlist",
        "operationId": "manageWishlist",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "action": { "type": "string", "enum": ["view", "add", "remove"], "default": "view" },
                  "productId": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Wishlist contents" } }
      }
    },
    "/api/tools/search_flights": {
      "post": {
        "summary": "Search flight tickets",
        "operationId": "searchFlights",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "origin": { "type": "string" },
                  "destination": { "type": "string" },
                  "departureDate": { "type": "string" },
                  "passengers": { "type": "integer", "default": 1 }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Flight search results" } }
      }
    },
    "/api/tools/search_airports": {
      "post": {
        "summary": "Airport and IATA code lookup",
        "operationId": "searchAirports",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "query": { "type": "string" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "Matching airports" } }
      }
    },
    "/api/tools/search_hotels": {
      "post": {
        "summary": "Search hotel stays",
        "operationId": "searchHotels",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "city": { "type": "string" },
                  "guests": { "type": "integer", "default": 2 }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Hotel list" } }
      }
    },
    "/api/tools/get_hotel_details": {
      "post": {
        "summary": "Get hotel room rates and amenities",
        "operationId": "getHotelDetails",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "hotelIdOrName": { "type": "string" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "Hotel details" } }
      }
    },
    "/api/tools/update_product_stock": {
      "post": {
        "summary": "Update product inventory stock",
        "operationId": "updateProductStock",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["productId", "stock"],
                "properties": {
                  "productId": { "type": "integer" },
                  "stock": { "type": "integer" },
                  "inStock": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Stock update confirmation" } }
      }
    },
    "/api/tools/list_merchant_orders": {
      "post": {
        "summary": "List merchant store orders (Admin Only)",
        "description": "Merchant Admin Tool ONLY: List store-wide customer orders. Requires store administrator authentication.",
        "operationId": "listMerchantOrders",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": { "type": "string" },
                  "limit": { "type": "integer", "default": 10 }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Orders list" } }
      }
    },
    "/api/tools/get_order_details": {
      "post": {
        "summary": "Get order details for merchant",
        "operationId": "getOrderDetails",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "orderId": { "type": "string" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "Order details" } }
      }
    },
    "/api/tools/update_order_status": {
      "post": {
        "summary": "Update order status",
        "operationId": "updateOrderStatus",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["orderId", "status"],
                "properties": {
                  "orderId": { "type": "string" },
                  "status": { "type": "string" },
                  "notes": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Status update confirmation" } }
      }
    },
    "/api/tools/list_promotions": {
      "post": {
        "summary": "List store promotions and coupons",
        "operationId": "listPromotions",
        "responses": { "200": { "description": "Promotions list" } }
      }
    },
    "/api/tools/create_coupon": {
      "post": {
        "summary": "Create discount coupon code",
        "operationId": "createCoupon",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["code", "discountType", "discountValue"],
                "properties": {
                  "code": { "type": "string" },
                  "discountType": { "type": "string", "enum": ["percentage", "fixed"] },
                  "discountValue": { "type": "number" },
                  "minOrderAmount": { "type": "number" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Coupon creation result" } }
      }
    },
    "/api/tools/delete_promotion_coupon": {
      "post": {
        "summary": "Delete or deactivate coupon",
        "operationId": "deletePromotionCoupon",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "couponCodeOrId": { "type": "string" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "Coupon deletion result" } }
      }
    },
    "/api/tools/run_merchant_workflow": {
      "post": {
        "summary": "Execute LangGraph autonomous agent workflow",
        "description": "Execute autonomous LangGraph agent workflow engine for multi-step merchant store operations, inventory routing, and order processing.",
        "operationId": "runMerchantWorkflow",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["instruction"],
                "properties": {
                  "instruction": { "type": "string", "description": "Natural language operational instruction or task" },
                  "threadId": { "type": "string" },
                  "approvalStatus": { "type": "string", "enum": ["approved", "rejected", "pending"] }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Workflow execution result" } }
      }
    },
    "/api/tools/merchant_login": {
      "post": {
        "summary": "Live Merchant Authentication",
        "description": "Authenticate merchant with email and password on live Shoppingate Merchant Auth service.",
        "operationId": "merchantLogin",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "default": "test@yopmail.com" },
                  "password": { "type": "string", "default": "Password@123" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Live authentication result" } }
      }
    },
    "/api/tools/customer_login": {
      "post": {
        "summary": "Customer Login authentication",
        "description": "Authenticate end-customer with phone or email and OTP/password to receive account profile and auth token.",
        "operationId": "customerLogin",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phone": { "type": "string" },
                  "email": { "type": "string" },
                  "otp": { "type": "string" },
                  "password": { "type": "string" },
                  "name": { "type": "string" },
                  "lang": { "type": "string", "default": "en" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "User session profile & JWT token" } }
      }
    },
    "/api/tools/get_user_profile": {
      "post": {
        "summary": "Get authenticated user profile",
        "description": "Retrieve current logged-in user profile details (Name, Email, Phone, Membership tier, Wallet balance).",
        "operationId": "getUserProfile",
        "responses": { "200": { "description": "User profile details" } }
      }
    }
  }
}
